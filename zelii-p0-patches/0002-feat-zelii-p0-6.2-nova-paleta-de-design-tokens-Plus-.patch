 apps/web/src/app/globals.css | 21 ++++++--
 apps/web/src/app/layout.tsx  | 30 +++++++++++-
 apps/web/tailwind.config.ts  | 13 +++++
 packages/ui/src/tokens.ts    | 93 +++++++++++++++++++++++++-----------
 5 files changed, 126 insertions(+), 33 deletions(-)

