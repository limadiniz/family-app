+                date: p.proposed_fields.date ?? '',
+                time: p.proposed_fields.time ?? '',
+                subjectPersonId: item.subject_person_id ?? '',
+              };
+            }
+          }
+          return next;
+        });
+      })
       .catch((err) => setError(err.message));
   }
 
-  useEffect(load, []);
+  useEffect(() => {
+    load();
+    apiFetch<Person[]>('/persons')
