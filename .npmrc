# Expo/Metro cannot reliably resolve pnpm's default symlinked,
# content-addressable node_modules layout for transitive/phantom
# dependencies pulled in by React Native libraries (expo-router and
# friends require packages like @babel/runtime, expo-splash-screen,
# etc. that are not hoisted into a shape Metro's resolver expects).
# Expo's official monorepo guidance for pnpm is to use hoisted linking,
# which gives a flat node_modules Metro can resolve without surprises.
# See https://docs.expo.dev/guides/monorepos/
node-linker=hoisted
