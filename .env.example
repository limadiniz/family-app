# ============================================================================
# Family Intelligence Platform — Environment Variables Template
# Copie para .env.local (web/api) ou .env (scripts) e preencha os valores.
# NUNCA cometer valores reais no repositório.
#
# Isto cobre só as variáveis que a APLICAÇÃO lê em runtime. Os segredos de
# CI/CD (SUPABASE_ACCESS_TOKEN, *_PROJECT_REF, FLY_API_TOKEN_*, etc.) não
# são variáveis de app — vivem como GitHub Actions secrets / Fly secrets /
# Vercel env vars. Ver DEPLOYMENT.md "Secrets by host" para o mapa completo
# de onde cada um vive e onde é gerado.
# ============================================================================

# --- Ambiente ---
NODE_ENV=development
APP_ENV=development                # development | staging | production

# --- Supabase (um projeto por ambiente: dev / staging / production) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=         # NUNCA expor ao cliente/mobile/web. Somente apps/api.
DATABASE_URL=                      # postgres connection string usada por packages/database (migrate/seed).
                                    # Supabase hospedado: Project Settings > Database > Connection string (modo "URI").
                                    # Local: aponte para qualquer Postgres 14+ vazio.
SUPABASE_DB_URL=                   # alias aceito por packages/database se DATABASE_URL não estiver definida

# --- API ---
API_PORT=4000
WEB_APP_URL=http://localhost:3100
API_BASE_URL=http://localhost:4000
API_JWT_AUDIENCE=authenticated
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Web ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Mobile (Expo) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
EXPO_TOKEN=                        # eas cli / CI publish token

# --- AI Gateway ---
AI_PROVIDER=anthropic               # anthropic | openai | azure-openai
AI_PROVIDER_API_KEY=
AI_MODEL=
AI_PROVIDER_TIMEOUT_MS=12000
AI_RATE_LIMIT_PER_MINUTE=20

# --- E-mail transacional ---
EMAIL_PROVIDER=                     # resend | sendgrid | ses
EMAIL_API_KEY=
EMAIL_FROM=no-reply@dominio.com.br

# --- Push Notifications ---
EXPO_PUSH_ACCESS_TOKEN=

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=info

# --- Feature Flags (defaults; ver packages/config/src/feature-flags.ts) ---
FF_AI_ENABLED=false                 # flag canônica da IA
FF_OCR_ENABLED=false
FF_FINANCE_ENABLED=true
FF_TEEN_ACCESS_ENABLED=true

# --- Domínios (placeholders até definição do domínio definitivo) ---
DOMAIN_ROOT=dominio.com.br
DOMAIN_WEB=app.dominio.com.br
DOMAIN_API=api.dominio.com.br
